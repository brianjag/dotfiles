# Sway Configuration for Debian 13 (Trixie)
#
# Documentation: man 5 sway

### Variables
# Super / Windows key as primary modifier
set $mod Mod4

# Direction keys (Vim-style)
set $left h
set $down j
set $up k
set $right l

# Preferred Applications
set $term alacritty
set $menu wofi --show drun
set $filemanager thunar
set $editor l3afpad
set $calc mate-calc

### Output Configuration
# Wallpaper: set to local share copy, with fallback to system sway background
output * bg ~/.local/share/backgrounds/wallpaper.jpg fill

### Input Configuration
input type:touchpad {
    dwt enabled
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
}

input type:keyboard {
    xkb_layout "latam,il"
    xkb_options "grp:win_space_toggle"
}

### Appearance
default_border pixel 2
default_floating_border pixel 2
gaps inner 4
gaps outer 2

client.focused          #89b4fa #1e1e2e #cdd6f4 #89b4fa #89b4fa
client.focused_inactive #45475a #1e1e2e #a6adc8 #45475a #45475a
client.unfocused        #313244 #1e1e2e #6c7086 #313244 #313244
client.urgent           #f38ba8 #1e1e2e #f38ba8 #f38ba8 #f38ba8

### Key Bindings

# Basics
bindsym $mod+Return exec $term
bindsym $mod+Shift+q kill
bindsym $mod+a exec $menu
bindsym $mod+d exec $menu
bindsym $mod+e exec $filemanager
bindsym $mod+Shift+e exec $editor
bindsym $mod+c exec $calc
bindsym $mod+p exec $HOME/.local/bin/pomodoro toggle

# Drag floating windows by holding down $mod and left mouse button
floating_modifier $mod normal

# Reload config & Logout
bindsym $mod+Shift+c reload
bindsym $mod+Shift+x exec swaynag -t warning -m 'Exit Sway?' -b 'Yes, exit sway' 'swaymsg exit'
bindsym $mod+Escape exec swaylock -f -c 1e1e2e

# Moving around (Vim keys)
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

# Moving around (Arrow keys)
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move focused container (Vim keys)
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

# Move focused container (Arrow keys)
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# Move container to workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Mouse Wheel Workspace Switching
bindsym --whole-window $mod+button4 workspace prev
bindsym --whole-window $mod+button5 workspace next

# Workspace Overview / Preview
bindsym $mod+Tab exec sov

# Layout Modes
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+t layout toggle split
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+Shift+a focus parent

# Scratchpad
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# Resizing containers
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Audio, Brightness, and Media Keys
bindsym XF86AudioRaiseVolume exec pamixer -i 5
bindsym XF86AudioLowerVolume exec pamixer -d 5
bindsym XF86AudioMute exec pamixer -t
bindsym XF86AudioMicMute exec pamixer --default-source -t
bindsym XF86MonBrightnessUp exec brightnessctl set +5%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# Screenshots (PrintScreen to clipboard)
bindsym Print exec grim -g "$(slurp)" - | wl-copy
bindsym Shift+Print exec grim - | wl-copy

### Autostart & Daemons
bar {
    swaybar_command waybar
}

exec --no-startup-id mako
exec --no-startup-id nwg-dock -d -p bottom -a center -i 48
exec --no-startup-id wlsunset -l -34.60 -L -58.38
exec --no-startup-id nm-applet --indicator
exec --no-startup-id /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1

exec swayidle -w \
    timeout 300 'swaylock -f -c 1e1e2e' \
    timeout 600 'swaymsg "output * dpms off"' \
    resume 'swaymsg "output * dpms on"' \
    before-sleep 'swaylock -f -c 1e1e2e'
